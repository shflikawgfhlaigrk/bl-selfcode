# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# OS / editor
.DS_Store
*.swp

# logs / scratch
*.log

# claude-flow tool state (regenerated; churns the tree and blocks selfcode propagation)
.claude-flow/

# build artifacts (Flutter/Xcode regenerate these)
/build/

# iCloud Desktop conflict copies (Finder/iCloud spawn these; never source)
* 2.py
* 2.html
* 2.plist
* 2
*.orig
*.bak
*.bak-*

# compiled on-device LLM bridge (rebuild: xcrun swiftc -O native/fm_cli.swift -o native/fm_cli)
native/fm_cli
# compiled STT bridge (Mach-O; rebuild from native/stt_cli.swift)
native/stt_cli

# pytest coverage artifacts
.coverage
.coverage.*
htmlcov/

# runtime memory store (SQLite — churns every run, holds private facts; not source)
/data/memory.db

# Flutter generated/ephemeral platform scaffolding (regenerated on build; conflict-prone)
/ios/Flutter/ephemeral/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.*
/ios/**/xcuserdata/
/macos/Flutter/ephemeral/

# Obsidian vault UI state (workspace.json churns constantly; not project source)
/.obsidian/
