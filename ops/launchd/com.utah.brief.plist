<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.utah.brief — morning brief cron (daily 06:35, just after quiet hours end 06:30).

  Runs utah.product.brief.run(push_fn=alerts.brief): composes the brief from LIVE Postgres
  state (revenue ledger, memory size, newest leads, open failure items) and PUSHES it to
  Michael's phone via Pushover, carrying a tap-through to the Utah deck over the tailnet.
  Push is the working delivery path while the Gmail app-password is rejected (mail/send_failed
  in the AUDIT log) — the brief no longer depends on email. Brief stream is priority 0, so it
  respects quiet hours; 06:35 is deliberately past the 06:30 window so it lands.

  Install:
    cp ops/launchd/com.utah.brief.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.utah.brief.plist
  Force-run now:  launchctl kickstart gui/$(id -u)/com.utah.brief
  Stop:           launchctl bootout  gui/$(id -u)/com.utah.brief
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.utah.brief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/michaelbarber/.utah/venv/bin/python</string>
    <string>-c</string>
    <string>import logging; logging.basicConfig(level=logging.INFO); from utah.product.brief import run; from utah import alerts; print(run(push_fn=alerts.brief))</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/michaelbarber/Desktop/ProjectUtah</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/michaelbarber/Desktop/ProjectUtah</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/michaelbarber/.utah/venv/bin:/opt/homebrew/bin:/usr/local/bin:/Users/michaelbarber/.local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>35</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/michaelbarber/.utah/logs/brief.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/michaelbarber/.utah/logs/brief.err</string>
</dict>
</plist>
