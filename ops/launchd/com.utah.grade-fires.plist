<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.utah.grade-fires — fire grader (every 15 min).

  Runs utah.product.fire_grader.run_scheduled(): grades every ungraded, non-synthetic
  fire older than its 30-min evaluation horizon against the persisted ``bars`` table
  (structural stop = prior-20-bar extreme, 2R target, per-bar close exits — the same
  math as the backtest harness) and fills fires.outcome/pnl. Fires with no persisted
  post-fire bars are marked 'ungradable' (pnl NULL) — never an invented price. This is
  what turns the signal lane into a sellable TRACK RECORD instead of ungraded noise.

  Install:
    cp ops/launchd/com.utah.grade-fires.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.utah.grade-fires.plist
  Force-run now:  launchctl kickstart gui/$(id -u)/com.utah.grade-fires
  Stop:           launchctl bootout  gui/$(id -u)/com.utah.grade-fires
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.utah.grade-fires</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/michaelbarber/.utah/venv/bin/python</string>
    <string>-c</string>
    <string>from utah.product import fire_grader; print(fire_grader.run_scheduled())</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/michaelbarber/Desktop/ProjectUtah</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/michaelbarber/Desktop/ProjectUtah</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/michaelbarber/.utah/venv/bin:/opt/homebrew/bin:/usr/local/bin:/Users/michaelbarber/.local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/michaelbarber/.utah/logs/grade-fires.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/michaelbarber/.utah/logs/grade-fires.err</string>
</dict>
</plist>
