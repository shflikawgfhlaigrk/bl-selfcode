<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.utah.codeindex — re-index Utah's own source into memory (daily + at load).

  Runs utah.codebase.ingest(): AST-chunks every module (functions/classes + each named
  constant + a module header), embeds them, and stores as source='code' so the brain can
  GROUND answers about its own implementation in the actual current code. Idempotent
  (clears prior 'code' rows first), so it tracks the live tree as SICA self-merges and
  edits land. Real source only — never fabricated.

  Install:
    cp ops/launchd/com.utah.codeindex.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.utah.codeindex.plist
  Force-run now:  launchctl kickstart gui/$(id -u)/com.utah.codeindex
  Stop:           launchctl bootout  gui/$(id -u)/com.utah.codeindex
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.utah.codeindex</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/michaelbarber/.utah/venv/bin/python</string>
    <string>-c</string>
    <string>import logging; logging.basicConfig(level=logging.INFO); from utah.codebase import ingest; print(ingest())</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/michaelbarber/Desktop/ProjectUtah</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/michaelbarber/Desktop/ProjectUtah</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/michaelbarber/.utah/venv/bin:/opt/homebrew/bin:/usr/local/bin:/Users/michaelbarber/.local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>86400</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/michaelbarber/.utah/logs/codeindex.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/michaelbarber/.utah/logs/codeindex.err</string>
</dict>
</plist>
