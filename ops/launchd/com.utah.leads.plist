<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.utah.leads — lead-scout cron (daily).

  Runs utah.product.leads.run_scheduled(): tiles the Atlanta metro frontier on
  Overpass, drops national chains + already-website businesses, writes each real
  no-website SMB to the product ledger (UNIQUE never-twice → no dupes across runs).
  Daily cadence is gentle on the free Overpass mirrors and matches how slowly local
  businesses change. Failures go to the leads log, never fabricated rows.

  Install:
    cp ops/launchd/com.utah.leads.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.utah.leads.plist
  Force-run now:  launchctl kickstart gui/$(id -u)/com.utah.leads
  Stop:           launchctl bootout  gui/$(id -u)/com.utah.leads
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.utah.leads</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/michaelbarber/.utah/venv/bin/python</string>
    <string>-c</string>
    <string>import logging; logging.basicConfig(level=logging.INFO); from utah.product.leads import run_scheduled; print(run_scheduled(target=500))</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/michaelbarber/Desktop/ProjectUtah</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/michaelbarber/Desktop/ProjectUtah</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/michaelbarber/.utah/venv/bin:/opt/homebrew/bin:/usr/local/bin:/Users/michaelbarber/.local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>86400</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/michaelbarber/.utah/logs/leads.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/michaelbarber/.utah/logs/leads.err</string>
</dict>
</plist>
